// program to read  characters from file using fgetc()
#include <stdio.h>
int main()
{
    FILE *fp;
    char ch;
    fp = fopen("charfile.txt ","r");
    if(fp == NULL)
    {
        printf("file opening failed!\n");
        return 1;
    }
    printf("file contents:\n");
    while((ch = fgetc(fp)) != EOF)
putchar(ch);

    fclose(fp);

    return 0;

}
