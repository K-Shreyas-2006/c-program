//program including strcpy(), strlen(), strcmp() ,strcat() using user input
#include<stdio.h>
#include<string.h>
int main()
{

    char str1[100];
    char str2[100];
    int op;
     printf("enter 1st string to be copied:");
    scanf("%s",&str1);
     printf("enter 2nd string to be copied:");
    scanf("%s",&str2);
    printf("enter ur choice");
    scanf("%d",&op);
    switch(op)
    {


    case 1 :
    printf("length of str1 : %lu\n",strlen(str1));

    break;

    case 2 :
    strcat(str1,str2);
    printf("result : %s" , str1);

    break;

    case 3 :
        strcpy(str2,str1);
    printf("copied string: %s\n",str2);

    break;

    case 4 :
    printf("comparsion result : %d\n", strcmp(str1,str2));
    break;

    default :
        printf("invalid");
        break;
    }

    return 0;
}
