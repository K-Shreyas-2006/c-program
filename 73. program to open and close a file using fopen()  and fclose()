// program to open and close a file using fopen()  and fclose()
#include <stdio.h>
int main()
{
    FILE *fp;
    fp = fopen("example .txt ","w"); // create or open the writeing
    if(fp == NULL)
    {
        printf("file opening failed!\n");
        return 1;
    }
    printf("file opened successfullyusing fopen().\n");
    fclose(fp);//closing the file
    printf("File Closed successfully using fclose().\n");
    return 0;


}

