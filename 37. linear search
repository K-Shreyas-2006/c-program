//linear serch

#include <stdio.h>


int main()
{
  int arr[5] = {10,23,35,47,59};
  int n = 5;
  int key,i,found=0;
  printf("enter the element to serch:");
  scanf("%d",&key);

  for (i=0;i<n;i++){
    if (arr[i]==key){
        printf("element %d found at position %d\n",key,i+1);
        found=1;
        break;

    }
  }
  if (!found)
    printf("elements not found\n");
  return 0;
}

