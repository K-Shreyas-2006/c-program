//program to insert an element into a sorted array in order
#include<stdio.h>
int main (){
int arr[10];
int n=5;
int value,i;
printf("enter the array");
for(i=0;i<n;i++){
scanf("%d",&arr[10]);
}
printf("enter elements to be inserted:");
scanf("%d", &value);
for(i= n-1; i>=0 && arr[i]> value;i--)
arr[i] = arr[i];
arr[i] = value;
n++;printf("array after insertion:");
for(i=0;i<n;i++)
printf("%d\n",arr[i]);
return 0;
