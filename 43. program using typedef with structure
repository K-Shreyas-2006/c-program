// program using typedef with structure
#include<stdio.h>
typedef struct {
    int emp_id;
    char name[20];
    float salary;
    
}employee;
int main(){
    employee e1 = {101, "kriran ", 45000.01};
    printf("employee id : %d\n", e1.emp_id);
    printf("name: %s\n",e1.name);
    printf("salary : %.2f\n", e1.salary);
    return 0;
    
}
